# ─────────────────────────────────────────────────────────────────────────
# Template only. Put real values in .env.local (development) or in the
# deployment environment (production). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────

# Neon pooled connection string — use a freshly ROTATED credential.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Encrypts the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Initial administrators, created by `npm run db:seed` (never overwritten once they exist).
# Passwords: 12+ characters with letters and numbers.
INITIAL_ADMIN_1_MOBILE=
INITIAL_ADMIN_1_PASSWORD=

INITIAL_ADMIN_2_MOBILE=
INITIAL_ADMIN_2_PASSWORD=

# Required by /api/cron/reconcile (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Optional
# DATABASE_POOL_MAX=5
# TEST_DATABASE_URL=   # disposable database for `npm run test:integration` — its schema is DROPPED
